# ==============================================================================
# ARORA COMMUNICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or configure in Vercel / hosting dashboard).
# NEVER commit real production secrets, passwords, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL Free Tier)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database:
# Connection Pooling (port 6543, transaction mode for serverless functions):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (port 5432, session mode for Prisma migrations & db push):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. IMAGE & FILE STORAGE (Supabase Storage Free Tier)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> API:
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Keep SUPABASE_SERVICE_ROLE_KEY private (Backend only, never in frontend!):
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="product-images"

# ------------------------------------------------------------------------------
# 3. BACKEND AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="production"
# Generate a strong 32+ character random string for production:
JWT_SECRET="arora_secure_random_jwt_secret_change_this_for_production"
JWT_EXPIRES_IN="7d"

# Allowed Client Origin for CORS (e.g., your Vercel frontend URL)
CLIENT_URL="https://your-frontend-project.vercel.app"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Optional - Cash on Delivery & Test Mode are default)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Vite Client Variables - Safe for browser)
# ------------------------------------------------------------------------------
# Point to your production backend API on Vercel:
# (If deploying full-stack on the same Vercel project, leave empty or use /api)
VITE_API_URL="https://your-backend-project.vercel.app/api"
VITE_STORE_NAME="Arora Communication"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
