# ==============================================================================
# ARORA COMMUNICATION - FRONTEND ENVIRONMENT VARIABLES (Vercel Frontend)
# ==============================================================================
# Add these variables to your Vercel Project Settings -> Environment Variables
# IMPORTANT: Only variables prefixed with VITE_ are bundled into client code.
# NEVER put database passwords or private API keys here.

# URL of your deployed Arora Communication Backend on Vercel
# Example: https://arora-backend.vercel.app/api
# If deployed on the same domain as the backend, leave blank or use /api
VITE_API_URL="https://your-backend-project.vercel.app/api"

# Store Branding
VITE_STORE_NAME="Arora Communication"

# Optional Payment Gateway Key (Client side Key ID only - never the secret!)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
