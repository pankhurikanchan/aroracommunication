# ==============================================================================
# ARORA COMMUNICATION - BACKEND ENVIRONMENT VARIABLES (Vercel Backend / Server)
# ==============================================================================
# Add these variables to your Vercel Project Settings -> Environment Variables

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database (Transaction pooler for serverless)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session pooler for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage & Client API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Authentication & Security
JWT_SECRET="arora_secure_random_jwt_secret_change_this_for_production"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
CLIENT_URL="https://your-frontend-project.vercel.app"

# Optional Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
